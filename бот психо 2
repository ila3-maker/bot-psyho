async def process_time_slots(update: Update, context: ContextTypes.DEFAULT_TYPE) -> int:
    """Обработка введенных временных слотов"""
    try:
        date_str = context.user_data.get('admin_edit_date')
        
        if not date_str:
            await update.message.reply_text("Ошибка: дата не найдена. Начните заново.")
            return ConversationHandler.END
        
        with get_db_connection() as conn:
            cursor = conn.cursor()
            cursor.execute('DELETE FROM time_slots WHERE date = ?', (date_str,))
            
            time_slots_str = update.message.text.strip()
            time_slots = [slot.strip() for slot in time_slots_str.split(',')]
            
            for time_slot in time_slots:
                if ':' in time_slot:
                    cursor.execute('INSERT INTO time_slots (date, time) VALUES (?, ?)', (date_str, time_slot))
            
            conn.commit()
        
        await update.message.reply_text(
            f"Слоты для даты {date_str} успешно обновлены!\n"
            f"Добавлено слотов: {len(time_slots)}"
        )
        
        return await admin_panel(update, context)
    except Exception as e:
        error_logger.error(f"Ошибка в process_time_slots: {e}")
        await update.message.reply_text("Произошла ошибка при обработке слотов.")
        return ConversationHandler.END

