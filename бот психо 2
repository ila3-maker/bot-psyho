async def confirm_admin_payment(update: Update, context: ContextTypes.DEFAULT_TYPE) -> int:
    """Подтверждение оплаты администратором"""
    try:
        query = update.callback_query
        await query.answer()
        
        payment_data = context.user_data.get('current_payment')
        if payment_data:
            date_str, time_str = payment_data
            
            update_payment_status(date_str, time_str, 1)
            
            with get_db_connection() as conn:
                cursor = conn.cursor()
                cursor.execute(
                    'SELECT user_id FROM time_slots WHERE date = ? AND time = ?',
                    (date_str, time_str)
                )
                row = cursor.fetchone()
            
            if row:
                user_id = row['user_id']
                
                date_obj = datetime.strptime(date_str, '%Y-%m-%d')
                formatted_date = date_obj.strftime('%d.%m.%Y')
                
                await context.bot.send_message(
                    chat_id=user_id,
                    text=f"✅ Ваша запись подтверждена!\n\n"
                         f"Дата: {formatted_date}\n"
                         f"Время: {time_str}\n\n"
                         f"За 2 часа до консультации вы получите напоминание."
                )
                
                consultation_time = datetime.strptime(f"{date_str} {time_str}", "%Y-%m-%d %H:%M")
                reminder_time = consultation_time - timedelta(hours=2)
                
                if reminder_time > datetime.now():
                    scheduler = context.application.job_queue
                    scheduler.run_once(
                        send_reminder,
                        (reminder_time - datetime.now()).total_seconds(),
                        data={'chat_id': user_id, 'time': time_str}
                    )
            
            delete_slot(date_str, time_str)
            
            await query.edit_message_text(
                "Оплата подтверждена! Клиент уведомлен."
            )
        
        return await admin_panel(update, context)
    except Exception as e:
        error_logger.error(f"Ошибка в confirm_admin_payment: {e}")
        return ADMIN_PANEL

async def send_reminder(context: ContextTypes.DEFAULT_TYPE):
    """Отправка напоминания о консультации"""
    try:
        job = context.job
        await context.bot.send_message(
            chat_id=job.data['chat_id'],
            text=f"⏰ Напоминание о консультации!\n\n"
                 f"Через 2 часа у вас консультация с психологом.\n"
                 f"Время: {job.data['time']}"
        )
        logger.info(f"Напоминание отправлено пользователю {job.data['chat_id']}")
    except Exception as e:
        error_logger.error(f"Ошибка отправки напоминания: {e}")

