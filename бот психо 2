async def handle_test_answer(update: Update, context: ContextTypes.DEFAULT_TYPE) -> int:
    """Обработка ответа на вопрос теста"""
    try:
        query = update.callback_query
        await query.answer()
        
        data = query.data
        question_num = int(data[1])
        answer_key = data[3]
        
        if 'test_answers' not in context.user_data:
            context.user_data['test_answers'] = []
        context.user_data['test_answers'].append((question_num, answer_key))
        
        if question_num == 5:
            return await show_test_results(update, context)
        
        return await ask_question(update, context, question_num=question_num+1)
    except Exception as e:
        error_logger.error(f"Ошибка в handle_test_answer: {e}")
        return ConversationHandler.END

async def show_test_results(update: Update, context: ContextTypes.DEFAULT_TYPE) -> int:
    """Показать результаты теста"""
    try:
        answers = context.user_data.get('test_answers', [])
        
        results = {'Лучший': 0, 'Хороший': 0, 'Крепкий орешек': 0, 'Разочарованный': 0}
        for q_num, answer_key in answers:
            result_type = TEST_KEY[q_num][answer_key]
            results[result_type] += 1
        
        total = len(answers)
        percentages = {}
        for key, count in results.items():
            percentages[key] = round((count / total) * 100) if total > 0 else 0
        
        result_text = "Результаты теста:\n\n"
        for key, perc in percentages.items():
            result_text += f"{key}: {perc}%\n"
        
        main_type = max(percentages, key=percentages.get)
        
        result_text += f"\nВаш основной тип: {main_type}\n\n"
        result_text += "Рекомендации:\n"
        result_text += RECOMMENDATIONS[main_type]
        
        keyboard = [
            [InlineKeyboardButton("Записаться на консультацию", callback_data='book_consult')]
        ]
        reply_markup = InlineKeyboardMarkup(keyboard)
        
        query = update.callback_query
        await query.edit_message_text(
            text=result_text,
            reply_markup=reply_markup
        )
        
        # Сохраняем результаты в БД
        try:
            with get_db_connection() as conn:
                cursor = conn.cursor()
                cursor.execute(
                    'INSERT INTO test_results (user_id, date, result_type, percentages) VALUES (?, ?, ?, ?)',
                    (query.from_user.id, datetime.now().strftime('%Y-%m-%d'), main_type, str(percentages))
                )
                conn.commit()
        except Exception as e:
            error_logger.error(f"Ошибка сохранения результатов теста: {e}")
        
        return START
    except Exception as e:
        error_logger.error(f"Ошибка в show_test_results: {e}")
        return ConversationHandler.END

