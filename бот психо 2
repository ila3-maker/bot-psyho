# ========== РАБОТА С БАЗОЙ ДАННЫХ ==========
def get_db_connection():
    """Получение соединения с БД с правильной обработкой путей"""
    conn = sqlite3.connect(str(DB_PATH))
    conn.row_factory = sqlite3.Row
    return conn

def init_db():
    """Инициализация базы данных SQLite"""
    try:
        logger.info(f"Инициализация БД по пути: {DB_PATH}")
        with get_db_connection() as conn:
            cursor = conn.cursor()

            # Таблица для слотов записи
            cursor.execute('''
                CREATE TABLE IF NOT EXISTS time_slots (
                    id INTEGER PRIMARY KEY AUTOINCREMENT,
                    date TEXT NOT NULL,
                    time TEXT NOT NULL,
                    is_booked INTEGER DEFAULT 0,
                    user_id INTEGER,
                    user_name TEXT,
                    payment_status INTEGER DEFAULT 0,
                    reminder_sent INTEGER DEFAULT 0,
                    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
                )
            ''')

            # Таблица для результатов тестов
            cursor.execute('''
                CREATE TABLE IF NOT EXISTS test_results (
                    id INTEGER PRIMARY KEY AUTOINCREMENT,
                    user_id INTEGER,
                    date TEXT,
                    result_type TEXT,
                    percentages TEXT,
                    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
                )
            ''')

            # Таблица для логов ошибок
            cursor.execute('''
                CREATE TABLE IF NOT EXISTS error_logs (
                    id INTEGER PRIMARY KEY AUTOINCREMENT,
                    error_text TEXT,
                    user_id INTEGER,
                    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
                )
            ''')

            conn.commit()
            logger.info("База данных успешно инициализирована")
    except Exception as e:
        error_logger.error(f"Ошибка инициализации БД: {e}\n{traceback.format_exc()}")
        raise

def log_error_to_db(error_text: str, user_id: int = None):
    """Логирование ошибки в БД"""
    try:
        with get_db_connection() as conn:
            cursor = conn.cursor()
            cursor.execute(
                'INSERT INTO error_logs (error_text, user_id) VALUES (?, ?)',
                (error_text[:500], user_id)
            )
            conn.commit()
    except:
        pass  # Игнорируем ошибки при логировании ошибок

def add_time_slot(date: str, time: str):
    """Добавление свободного слота для записи"""
    try:
        with get_db_connection() as conn:
            cursor = conn.cursor()
            cursor.execute('INSERT INTO time_slots (date, time) VALUES (?, ?)', (date, time))
            conn.commit()
            logger.info(f"Добавлен слот: {date} {time}")
    except Exception as e:
        error_logger.error(f"Ошибка добавления слота: {e}")

def get_available_dates() -> List[str]:
    """Получение списка дат, на которые есть хотя бы один свободный слот"""
    try:
        with get_db_connection() as conn:
            cursor = conn.cursor()
            cursor.execute('''
                SELECT DISTINCT date FROM time_slots 
                WHERE is_booked = 0 
                AND date >= date('now') 
                AND date <= date('now', '+7 days')
                ORDER BY date
            ''')
            return [row['date'] for row in cursor.fetchall()]
    except Exception as e:
        error_logger.error(f"Ошибка получения дат: {e}")
        return []

def get_available_times(date: str) -> List[str]:
    """Получение свободных временных слотов на конкретную дату"""
    try:
        with get_db_connection() as conn:
            cursor = conn.cursor()
            cursor.execute(
                'SELECT time FROM time_slots WHERE date = ? AND is_booked = 0 ORDER BY time',
                (date,)
            )
            return [row['time'] for row in cursor.fetchall()]
    except Exception as e:
        error_logger.error(f"Ошибка получения времени: {e}")
        return []

def book_slot(date: str, time: str, user_id: int, user_name: str):
    """Бронирование слота пользователем"""
    try:
        with get_db_connection() as conn:
            cursor = conn.cursor()
            cursor.execute(
                '''UPDATE time_slots 
                   SET is_booked = 1, user_id = ?, user_name = ? 
                   WHERE date = ? AND time = ? AND is_booked = 0''',
                (user_id, user_name, date, time)
            )
            conn.commit()
            logger.info(f"Слот забронирован: {date} {time} пользователем {user_id}")
    except Exception as e:
        error_logger.error(f"Ошибка бронирования слота: {e}")

